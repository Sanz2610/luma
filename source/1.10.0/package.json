{
  "name": "luma-viewer",
  "version": "1.10.0",
  "description": "A focused local photo viewer for Windows",
  "author": {
    "name": "Sanz2610",
    "url": "https://github.com/Sanz2610"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/library.test.cjs tests/layout.test.mjs tests/thumbnail-service.test.cjs tests/window-state.test.cjs tests/updates.test.cjs",
    "test:app": "node tests/app.mjs",
    "test:packaged": "node tests/packaged.mjs",
    "test:portable": "node tests/portable.mjs",
    "test:stability": "node tests/stability.mjs",
    "dist": "npm run build && node scripts/notices.mjs && electron-builder --win nsis portable --x64 --publish never",
    "test:lens": "node tests/lens.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:formats": "node tests/formats.mjs",
    "format:check": "prettier --check src electron tests scripts package.json",
    "lint": "npm run format:check",
    "test:windows": "node tests/windows.mjs",
    "test:updates": "node tests/updates.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "test:about": "node tests/about.mjs",
    "source:export": "node scripts/export-source.mjs",
    "test:donations": "node tests/donations.mjs",
    "test:folders": "node tests/folders.mjs",
    "test:viewer": "node tests/viewer.mjs",
    "release:codecs": "node scripts/codec-sources.mjs",
    "test:interactions": "node tests/interactions.mjs",
    "test:viewer-options": "node tests/viewer-options.mjs"
  },
  "build": {
    "appId": "local.luma.viewer",
    "productName": "Luma",
    "artifactName": "Luma-${version}-Windows.${ext}",
    "directories": {
      "output": "../work/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/libheif-js/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "Luma-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sanz2610",
        "repo": "luma",
        "private": false,
        "releaseType": "draft"
      }
    ],
    "extraResources": [
      {
        "from": "build/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.luma.txt"
      },
      {
        "from": "CREDITS.md",
        "to": "CREDITS.md"
      },
      {
        "from": "CODEC_SOURCES.md",
        "to": "CODEC_SOURCES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exiftool-vendored.exe": "^13.59.3",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.59.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "yazl": "^3.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanz2610/luma.git"
  }
}
