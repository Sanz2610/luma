{
  "name": "luma-viewer",
  "version": "1.12.0",
  "description": "A local media viewer for Windows",
  "author": {
    "name": "Sanz2610",
    "url": "https://github.com/Sanz2610"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "dist": "npm run build && node scripts/notices.mjs && electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "local.luma.viewer",
    "productName": "Luma",
    "artifactName": "Luma-${version}-Windows.${ext}",
    "directories": {
      "output": "../work/release"
    },
    "files": [
      "!node_modules/@jsquash/jxl/codec/enc/**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/libheif-js/**/*",
      "node_modules/@jsquash/jxl/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "Luma-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sanz2610",
        "repo": "luma",
        "private": false,
        "releaseType": "draft"
      }
    ],
    "extraResources": [
      {
        "from": "build/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.luma.txt"
      },
      {
        "from": "CREDITS.md",
        "to": "CREDITS.md"
      },
      {
        "from": "CODEC_SOURCES.md",
        "to": "CODEC_SOURCES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "dependencies": {
    "@jsquash/jxl": "1.3.0",
    "electron-updater": "^6.8.9",
    "exiftool-vendored.exe": "^13.59.3",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanz2610/luma.git"
  }
}
